{
  "name": "zenix-manufacturing-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "styles": "node scripts/build-styles.mjs",
    "dev": "npm run styles && vite",
    "build": "npm run styles && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:domain": "node scripts/run-domain-tests.mjs",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "test": "npm run test:domain && npm run test:ui",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
